<form class="form-horizontal">
    <div class="control-group">
        <label class="checkbox">
            <input type="checkbox" data-bind="checked: enabled"> Enable AutoFarm (autonomous queue)
        </label>
    </div>
    <div class="control-group">
        <label class="checkbox">
            <input type="checkbox" data-bind="checked: auto_eject"> Auto-eject with gcode sweep (unchecked = notify and wait for you to remove part)
        </label>
    </div>
    <div class="control-group">
        <label class="control-label">Printer profile</label>
        <div class="controls">
            <select data-bind="value: printer_profile, options: Object.keys({{ plugin_autofarm_profiles|default({})|tojson }}), optionsText: function(k){ return {{ plugin_autofarm_profiles|default({})|tojson }}[k].name; }"></select>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label">Bed-clear check</label>
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: bed_clear_check, enable: {{ plugin_autofarm_has_cv2|default(false)|tojson }}"> Confirm bed is clear (webcam) before starting next print
            </label>
            {% if not plugin_autofarm_has_cv2 %}
                <span class="help-block">
                    opencv-python not available, this is disabled.
                    {% if plugin_autofarm_cv2_import_error %}<br><code>{{ plugin_autofarm_cv2_import_error }}</code>{% endif %}
                </span>
            {% endif %}
            <button class="btn" data-bind="click: setEmptyReference" {{ 'disabled' if not plugin_autofarm_has_cv2 }}>Capture empty-bed reference now</button>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label">Relay power-off</label>
        <div class="controls">
            <select data-bind="value: relay_mode">
                <option value="manual">Manual (notify me)</option>
                <option value="gpio" {{ 'disabled' if not plugin_autofarm_has_gpio }}>Raspberry Pi GPIO{{ ' (unavailable)' if not plugin_autofarm_has_gpio }}</option>
            </select>
            <label>GPIO pin <input type="number" data-bind="value: relay_gpio_pin" style="width:60px" {{ 'disabled' if not plugin_autofarm_has_gpio }}></label>
            <label class="checkbox"><input type="checkbox" data-bind="checked: relay_active_low" {{ 'disabled' if not plugin_autofarm_has_gpio }}> Active low</label>
        </div>
    </div>
    <div class="control-group">
        <span class="help-block">Test buttons (eject move, bed-clear check) are on the AutoFarm sidebar tab, not here - that's where the result shows up.</span>
    </div>
</form>
